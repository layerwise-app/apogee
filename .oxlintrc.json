{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-perf", "jsx-a11y", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    // Flags the documented `let cancelled = true` cleanup pattern inside effects.
    "react/immutability": "off",
    // canvas role="img", div role="status" and role="group" are valid ARIA here.
    "jsx-a11y/prefer-tag-over-role": "off",
    // Sorting a freshly built array is fine; toSorted() needs an ES2023 lib.
    "unicorn/no-array-sort": "off"
  },
  // shadcn/ui components are generated and not used by the site.
  "ignorePatterns": ["src/routeTree.gen.ts", "src/lib/earth/land-data.ts", "src/components/ui/**"]
}
